<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>webapp-testkit</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>webapp-testkit-app</artifactId>
  <name>Webapp Testkit App</name>
  <description>Stage and host a separately built web application for a browser test.</description>
  <dependencies>
    <!-- FramedApplication exposes DomScope; ApplicationRule rebinds Dom's scope. -->
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>webapp-testkit-dom</artifactId>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <!-- ApplicationRule is a rule used by consumer tests. -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
