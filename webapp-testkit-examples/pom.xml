<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>webapp-testkit</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>webapp-testkit-examples</artifactId>
  <name>Webapp Testkit Examples</name>
  <description>Worked examples: a plain page, a WebFX application and a React application.</description>

  <properties>
    <!-- This module is an exercise for repository checkouts, not a consumer dependency. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <!-- The example component is compiled by TeaVM alongside the tests that drive it. -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
    </dependency>
    <!-- The examples, and only the examples, show the testkit composed with mocking. -->
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>mockatcha-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>webapp-testkit-app</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>webapp-testkit-dom</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Declared before teavm-junit so rules run in this module's own tests. -->
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>teavm-rule-support</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Compile scope: TeaVM needs the class library to compile the sample application. -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>react</artifactId>
      <version>18.3.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>react-dom</artifactId>
      <version>18.3.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- ApplicationFiles never overwrites, so clear the staging area for repeat builds. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>reset-staged-applications</id>
            <phase>process-test-resources</phase>
            <goals><goal>clean</goal></goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset><directory>${project.build.testOutputDirectory}/applications</directory></fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <!-- Startup-failure fixtures, staged so their errors are captured the same way. -->
          <execution>
            <id>stage-fixtures</id>
            <phase>process-test-resources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.instanto.webapp.testkit.app.ApplicationFiles</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>${project.basedir}/src/test/applications</argument>
                <argument>${project.build.testOutputDirectory}/applications</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- Stages this module's application exactly as a downstream build would stage its own. -->
          <execution>
            <id>stage-application</id>
            <phase>process-test-resources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.instanto.webapp.testkit.app.ApplicationFiles</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>${project.basedir}/src/main/resources/webapp</argument>
                <argument>${project.build.testOutputDirectory}/applications/plain-js</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- The application this build just compiled, staged like any third party's. -->
          <execution>
            <id>stage-teavm-application</id>
            <phase>process-test-resources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.instanto.webapp.testkit.app.ApplicationFiles</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>${project.build.directory}/teavm-app</argument>
                <argument>${project.build.testOutputDirectory}/applications/teavm</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- A third toolchain: an Angular build, staged unchanged. -->
          <execution>
            <id>stage-angular-application</id>
            <phase>process-test-resources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.instanto.webapp.testkit.app.ApplicationFiles</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>${project.basedir}/src/main/resources/angular</argument>
                <argument>${project.build.testOutputDirectory}/applications/angular</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- A second application, built by an entirely different toolchain. -->
          <execution>
            <id>stage-webfx-application</id>
            <phase>process-test-resources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.instanto.webapp.testkit.app.ApplicationFiles</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>${project.basedir}/src/main/resources/webfx</argument>
                <argument>${project.build.testOutputDirectory}/applications/webfx</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>stage-react-application</id>
            <phase>process-test-resources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.instanto.webapp.testkit.app.ApplicationFiles</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>${project.basedir}/src/main/resources/react</argument>
                <argument>${project.build.testOutputDirectory}/applications/react</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- React itself comes from the webjars rather than being checked in. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-react</id>
            <phase>process-test-resources</phase>
            <goals><goal>unpack</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.webjars.npm</groupId>
                  <artifactId>react</artifactId>
                  <version>18.3.1</version>
                  <includes>**/umd/react.development.js</includes>
                  <outputDirectory>${project.build.directory}/react-scripts</outputDirectory>
                  <fileMappers>
                    <org.codehaus.plexus.components.io.filemappers.FlattenFileMapper/>
                  </fileMappers>
                </artifactItem>
                <artifactItem>
                  <groupId>org.webjars.npm</groupId>
                  <artifactId>react-dom</artifactId>
                  <version>18.3.1</version>
                  <includes>**/umd/react-dom.development.js</includes>
                  <outputDirectory>${project.build.directory}/react-scripts</outputDirectory>
                  <fileMappers>
                    <org.codehaus.plexus.components.io.filemappers.FlattenFileMapper/>
                  </fileMappers>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Build the TeaVM sample application, exactly as its own project would. -->
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <id>compile-sample-application</id>
            <phase>process-classes</phase>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>io.instanto.webapp.testkit.examples.StagedTimesheetApp</mainClass>
              <targetType>JAVASCRIPT</targetType>
              <minifying>false</minifying>
              <stopOnErrors>true</stopOnErrors>
              <targetDirectory>${project.build.directory}/teavm-app/js</targetDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>place-the-sample-applications-page</id>
            <phase>process-classes</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/teavm-app</outputDirectory>
              <resources>
                <resource><directory>src/main/resources/teavm-app</directory></resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>place-react-beside-the-page</id>
            <phase>process-test-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.testOutputDirectory}/applications/react</outputDirectory>
              <resources>
                <resource><directory>${project.build.directory}/react-scripts</directory></resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <teavm.junit.target>${project.build.directory}/js-tests</teavm.junit.target>
            <teavm.junit.js.runner>${webapp.testkit.test.browser}</teavm.junit.js.runner>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
