<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>instanto-org-pom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>

  <groupId>io.instanto</groupId>
  <artifactId>webapp-testkit</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Webapp Testkit</name>
  <description>Testing web applications from Java, in a real browser, through TeaVM.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>webapp-testkit-layout</module>
    <module>webapp-testkit-dom</module>
    <module>webapp-testkit-app</module>
    <module>webapp-testkit-examples</module>
  </modules>

  <distributionManagement>
    <repository>
      <id>github-webapp-testkit</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/instanto-io/webapp-testkit</url>
    </repository>
    <snapshotRepository>
      <id>github-webapp-testkit</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/instanto-io/webapp-testkit</url>
    </snapshotRepository>
  </distributionManagement>

  <!-- JUnit rule support is a separate library now. -->
  <repositories>
    <repository>
      <!-- Every Instanto package, not just one repository's: this build also needs
           mockatcha-core, which teavm-rule-support's registry does not serve. -->
      <id>github</id>
      <url>https://maven.pkg.github.com/instanto-io/*</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <scm>
    <url>https://github.com/instanto-io/webapp-testkit</url>
    <connection>scm:git:https://github.com/instanto-io/webapp-testkit.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/instanto-io/webapp-testkit.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <teavm.version>0.15.0</teavm.version>
    <junit.version>4.13.2</junit.version>
    <teavm-rule-support.version>0.1.0-SNAPSHOT</teavm-rule-support.version>
    <!-- Only the examples use it, to show a mocked boundary behind a UI. -->
    <mockatcha.version>0.1.0-SNAPSHOT</mockatcha.version>
    <webapp.testkit.test.browser>browser-chrome</webapp.testkit.test.browser>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>webapp-testkit-layout</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>webapp-testkit-dom</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>webapp-testkit-app</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>teavm-rule-support</artifactId>
        <version>${teavm-rule-support.version}</version>
      </dependency>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>mockatcha-core</artifactId>
        <version>${mockatcha.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-jso</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-jso-apis</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-core</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-classlib</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-junit</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>${junit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0-M1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <configuration>
          <doclint>all,-missing</doclint>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
